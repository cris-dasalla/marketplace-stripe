# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Server-only. Used for sellers, orders and marking listings sold. Never NEXT_PUBLIC.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Stripe sandbox (test mode) keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
# Printed by scripts/create-webhook.mjs
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# Optional: email sellers when a buyer messages them
GMAIL_USER=
GMAIL_APP_PASSWORD=
